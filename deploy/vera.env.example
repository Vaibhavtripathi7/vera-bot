# /etc/vera.env  (chmod 600) - never commit real keys
TEAM_NAME=Vaibhav Tripathi
TEAM_MEMBERS=Vaibhav Tripathi
CONTACT_EMAIL=
SUBMITTED_AT=2026-09-28T00:00:00Z

VERA_DB_PATH=/var/lib/vera/state.db
VERA_SESSION_IDLE_RESET=2700

LLM_ENABLED=1
GEMINI_API_KEY=
GEMINI_WRITER_MODEL=gemini-2.5-flash
GEMINI_CRITIC_MODEL=gemini-2.5-flash-lite
# set these from https://aistudio.google.com/rate-limit (keep ~20% headroom)
GEMINI_WRITER_RPM=8
GEMINI_WRITER_RPD=200
GEMINI_CRITIC_RPM=12
GEMINI_CRITIC_RPD=800
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile
GROQ_RPM=25
GROQ_RPD=800
