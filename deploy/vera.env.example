# /etc/vera.env  (chmod 600) - never commit real keys
TEAM_NAME=Vaibhav Tripathi
TEAM_MEMBERS=Vaibhav Tripathi
CONTACT_EMAIL=
SUBMITTED_AT=2026-09-28T00:00:00Z

VERA_DB_PATH=/var/lib/vera/state.db
VERA_SESSION_IDLE_RESET=2700

LLM_ENABLED=1
GEMINI_API_KEY=
GEMINI_WRITER_MODELS=gemini-3.5-flash,gemini-3.8-flash,gemini-3.6-flash,gemini-3.5-flash-lite
GEMINI_CRITIC_MODELS=gemini-flash-lite-latest,gemini-3.5-flash-lite
# per-model free-tier limits model:rpm:rpd (from https://aistudio.google.com/rate-limit, ~10-20% headroom)
GEMINI_LIMITS=gemini-3.5-flash:4:18,gemini-3.6-flash:4:18,gemini-3.7-flash:4:18,gemini-3.8-flash:4:18,gemini-3.5-flash-lite:12:450,gemini-flash-lite-latest:12:450
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile
GROQ_RPM=25
GROQ_RPD=800
